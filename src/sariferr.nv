// sariferr.nv — what reading a log refuses, and the checks a written
// one should pass first.
//
// TWO DIFFERENT THINGS LIVE HERE AND THE DIFFERENCE IS THE POINT.
//
// `SarifError` is a REFUSAL: the bytes handed to `sarifjson.read` are
// not a SARIF 2.1.0 log, and there is nothing to hand back.  It carries
// a JSON Pointer, because a reader staring at a 40 MB log needs to be
// told `/runs/0/results/318/locations/0` rather than "invalid
// document".
//
// `SarifProblem` is a FINDING ABOUT A LOG that parsed: a result whose
// `ruleId` and `ruleIndex` disagree, a fix whose replacement would
// delete a file, a `pass` carrying `level: "error"`, two artifacts that
// are two spellings of one path.  None of those stop a document being
// read and every one of them is a bug in whatever wrote it.
//
// The two are separate types because a validator that raised on the
// second class would be unusable against real logs — the tools that
// produce them break these rules constantly — and a reader that ignored
// the second class would silently pass their damage on.  `problems` is
// a list, always, and the caller decides.

// Why a document could not be read as a SARIF 2.1.0 log.
pub enum SarifError
    // The bytes are not JSON at all.
    SarifNotJson(why: Str)
    // Valid JSON, wrong shape: a member the format requires is missing
    // or is of another type.  `pointer` is the RFC 6901 JSON Pointer of
    // the place, and `want` says what was expected there.
    SarifBadShape(pointer: Str, want: Str, got: Str)
    // A `version` this package does not read.  Named separately from a
    // shape fault because it is the one refusal a caller can act on —
    // by finding a converter — and because reading a 1.0 log as a 2.1.0
    // one gives wrong answers rather than no answers.
    SarifWrongVersion(found: Str)
    // An index that points outside its table.  The one class of fault
    // that a schema validator passes and a reader cannot: `ruleIndex:
    // 7` in a run with three rules is well-formed JSON matching the
    // schema, and means nothing.
    SarifIndexOutOfRange(pointer: Str, index: Int, size: Int)
    // A string where the format admits a fixed set and this is not one
    // of them — `level: "fatal"`, `kind: "broken"`.
    SarifUnknownEnum(pointer: Str, field: Str, value: Str)
    // The document nests deeper than the reader will follow.  A bound
    // rather than a stack overflow: a SARIF log arrives from a build
    // service and is therefore input from outside.
    SarifTooDeep(pointer: Str, limit: Int)

// The sentence a refusal is: what was wrong, and the value that showed
// it.  The pointer is in `error_pointer` and not in the sentence, so a
// caller renders it in its own diagnostic shape.
//
// A reader here and the `message` the `Error` impl publishes from it,
// because `render` needs the sentence too and a method of a trait is
// reached through the trait.
fn fault_message(e: SarifError) -> Str
    match e
        SarifNotJson(why)                          => "the text is not JSON: " + why
        SarifBadShape(pointer, want, got)          =>
            "${want} expected at ${pointer}, found ${got}"
        SarifWrongVersion(found)                   =>
            "this is not a SARIF 2.1.0 log; its version says ${found}"
        SarifIndexOutOfRange(pointer, index, size) =>
            "the index ${index} at ${pointer} is outside a table of ${size}"
        SarifUnknownEnum(pointer, field, value)    =>
            "${field} is ${value} at ${pointer}, which is not a spelling the format defines"
        SarifTooDeep(pointer, limit)               =>
            "the document nests deeper than ${limit} levels at ${pointer}"

// `SarifError` is an `Error`, which is what lets
// `Result<SarifLog, SarifError>` exist at all (SPEC § 3.4).
impl Error for SarifError
    // The one-line message, naming the rule rather than the reader's
    // state.  The pointer is in the value and not in the sentence, so a
    // caller renders it in its own diagnostic shape.
    fn message(self) -> Str
        fault_message(self)

// Something wrong with a log that parsed.
//
// Every variant is a document a schema validator accepts and a consumer
// misreads.
pub enum SarifProblem
    // A result's `ruleId` names one rule and its `ruleIndex` another.
    // A consumer that reads the string and a consumer that reads the
    // index then report two different rules for one finding.
    SarifRuleIdMismatch(result_index: Int, id: Str, indexed_id: Str)
    // A result whose kind is not `fail` carries a level that is not
    // `none` — § 3.27.10.  A consumer that reads level without reading
    // kind reports a passing check as a failure.
    SarifLevelForKind(result_index: Int, kind: Str, level: Str)
    // A fix whose replacement names no region, and therefore replaces
    // the whole artifact.  Applying it deletes the file, which is a
    // thing tools have shipped.
    SarifUnboundedFix(result_index: Int, fix_index: Int)
    // Two artifacts whose URIs differ only by a path spelling: `./a`
    // and `a`, `a/../b` and `b`.  This package interns by BYTE
    // equality on purpose — deciding two paths are one means knowing
    // what they are relative to — so the duplicate is reported rather
    // than merged.
    SarifDuplicateArtifact(first: Int, second: Int, uri: Str)
    // A rule declared twice with different descriptions.
    SarifDuplicateRule(first: Int, second: Int, id: Str)
    // A result whose region carries a character offset and a text
    // position that cannot both be right about the same range — one
    // says line 1 and the other says offset 4000.  Not always
    // detectable and detected where it is, because an emitter that
    // wrote a byte offset into `charOffset` produces a document that
    // highlights the wrong text in every viewer.
    SarifRegionDisagrees(result_index: Int, location_index: Int)
    // A timestamp that is not SARIF's RFC 3339 profile.
    SarifBadTimestamp(pointer: Str, value: Str)
    // An artifact nothing points at.  Not an error — a tool may list
    // what it scanned — but worth saying, because it is also what a
    // merge that concatenated instead of re-interning leaves behind.
    SarifOrphanArtifact(index: Int, uri: Str)

// A one-line message for a problem.
pub fn problem_message(p: SarifProblem) -> Str []
    match p
        SarifRuleIdMismatch(i, id, indexed_id)     =>
            "result ${i}: ruleId \"${id}\" and the rule at its index, \"${indexed_id}\", are two rules"
        SarifLevelForKind(i, kind, level)          =>
            "result ${i}: kind \"${kind}\" carries level \"${level}\", and a level other than none means something only for a fail"
        SarifUnboundedFix(i, f)                    =>
            "result ${i}: fix ${f} replaces a region that says nothing, so applying it replaces the whole artifact"
        SarifDuplicateArtifact(first, second, uri) =>
            "artifacts ${first} and ${second} are two spellings of ${uri}"
        SarifDuplicateRule(first, second, id)      =>
            "rule \"${id}\" is declared at ${first} and again at ${second}"
        SarifRegionDisagrees(i, l)                 =>
            "result ${i}: location ${l} carries a text position and a character offset that cannot both be right"
        SarifBadTimestamp(pointer, value)          =>
            "the timestamp \"${value}\" at ${pointer} is not SARIF's RFC 3339 profile"
        SarifOrphanArtifact(i, uri)                =>
            "artifact ${i} (${uri}) is pointed at by no result"

// Whether a problem would make a consumer report the wrong thing, as
// opposed to merely being untidy.
//
// True for the rule-identifier mismatch, the level-for-kind fault, the
// unbounded fix and the disagreeing region; false for the duplicates
// and the orphan.  The split a caller uses to decide whether to refuse
// a log or to log a warning about it.
pub fn problem_is_serious(p: SarifProblem) -> Bool []
    match p
        SarifRuleIdMismatch(_, _, _)    => true
        SarifLevelForKind(_, _, _)      => true
        SarifUnboundedFix(_, _)         => true
        SarifRegionDisagrees(_, _)      => true
        // A timestamp outside the profile is a log a build service
        // refuses, which is worse than untidy and is not a wrong
        // report either — the one variant the sentence above does not
        // name, and it is not serious for the reason the others are.
        SarifBadTimestamp(_, _)         => true
        SarifDuplicateArtifact(_, _, _) => false
        SarifDuplicateRule(_, _, _)     => false
        SarifOrphanArtifact(_, _)       => false

// The JSON Pointer of the place an error refers to, or the empty
// string.
pub fn error_pointer(e: SarifError) -> Str []
    match e
        SarifNotJson(_)               => ""
        SarifWrongVersion(_)          => ""
        SarifBadShape(p, _, _)        => p
        SarifIndexOutOfRange(p, _, _) => p
        SarifUnknownEnum(p, _, _)     => p
        SarifTooDeep(p, _)            => p

// `<file>: <message>`, or `<file>#<pointer>: <message>` when there is a
// pointer.
//
// `file` is the caller's — this package never opened anything.
//
// ```novo
// use sariferr
//
// fn main() [io]
//     println(sariferr.render(SarifWrongVersion("1.0.0"), "out.sarif"))
// ```
pub fn render(e: SarifError, file: Str) -> Str []
    let pointer = error_pointer(e)
    if pointer == ""
        return file + ": " + fault_message(e)
    file + "#" + pointer + ": " + fault_message(e)
